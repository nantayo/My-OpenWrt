config interface 'loopback'
	option proto 'static'
	option device 'lo'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config interface 'lan'
	option proto 'static'
	option device 'br-lan'
	option ipaddr '192.168.3.1/27'
	option multipath 'off'
	option ip6assign '60'

config interface 'wan'
	option proto 'pppoe'
	option device 'eth0'
	option username '15840655516@net'
	option password '12345678'
	option multipath 'off'
	option ipv6 'auto'
	option norelease '1'

config device
	option type 'bridge'
	option name 'br-lan'
	list ports 'eth1'
	list ports 'eth2'

config globals 'globals'
	option packet_steering '2'
	option steering_flows '256'
