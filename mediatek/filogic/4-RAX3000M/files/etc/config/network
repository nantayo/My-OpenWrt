config interface 'loopback'
	option proto 'static'
	option device 'lo'
	option ipaddr '127.0.0.1/8'

config interface 'lan'
	option proto 'static'
	option device 'br-lan'
	option ipaddr '192.168.4.1/27'
	option multipath 'off'
	option ip6assign '60'

config interface 'wan'
	option proto 'pppoe'
	option device 'eth1'
	option username '13390510206@net'
	option password '12345678'
	option multipath 'off'
	option ipv6 'auto'
	option norelease '1'

config device
	option type 'bridge'
	option name 'br-lan'
	list ports 'lan1'
	list ports 'lan2'
	list ports 'lan3'

config globals 'globals'
	option packet_steering '0'
