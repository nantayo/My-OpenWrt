config interface 'loopback'
	option proto 'static'
	option device 'lo'
	option ipaddr '127.0.0.1/8'

config interface 'lan'
	option proto 'dhcp'
	option device 'br-lan'
	option sendclientid 'auto'
	option multipath 'off'

config device
	option type 'bridge'
	option name 'br-lan'
	list ports 'wan'
	list ports 'lan1'
	list ports 'lan2'
	list ports 'lan3'

config globals 'globals'
	option packet_steering '2'
	option steering_flows '256'