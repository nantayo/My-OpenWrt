CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7583=y
CONFIG_TARGET_airoha_an7583_DEVICE_nokia_xg-040g-mf-ubi=y
CONFIG_TARGET_ROOTFS_INITRAMFS=n

# dae
CONFIG_BPF_TOOLCHAIN_HOST=y
CONFIG_DEVEL=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_DEBUG_INFO_REDUCED=n
CONFIG_KERNEL_XDP_SOCKETS=y
CONFIG_PACKAGE_luci-app-dae=y
CONFIG_PACKAGE_vmlinux-btf-builtin=y

# luci
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_luci-app-pon=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-zerotier=y

# kmod
CONFIG_PACKAGE_kmod-lib-lz4=y

# other packages
CONFIG_PACKAGE_at=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_SAMBA4_SERVER_AVAHI=n
CONFIG_SAMBA4_SERVER_NETBIOS=n
CONFIG_SAMBA4_SERVER_VFS=n