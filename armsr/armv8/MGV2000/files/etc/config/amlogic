config amlogic 'config'
	option enable '1'
	option amlogic_firmware_repo 'https://github.com/nantayo/My-OpenWrt'
	option amlogic_firmware_tag 'armsr_armv8'
	option amlogic_firmware_suffix '.img.gz'
	option amlogic_kernel_path 'https://github.com/ophub/kernel'
	option amlogic_kernel_tags 'kernel_flippy'
	option amlogic_kernel_branch '6.18'
	option amlogic_firmware_config '1'
	option amlogic_write_bootloader '1'
	option amlogic_shared_fstype 'ext4'

config settings 'armcpu'
	option governor0 'performance'
	option minfreq0 '2016000'
	option maxfreq0 '2016000'
